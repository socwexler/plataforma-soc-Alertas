# Copie este archivo como .env y cambie los valores.
POSTGRES_DB=soc
POSTGRES_USER=soc
POSTGRES_PASSWORD=cambie-esta-clave

# Clave para firmar las sesiones (cadena larga y aleatoria)
JWT_SECRET=cambie-esta-cadena-por-una-larga-y-aleatoria
JWT_HORAS=10

# Usuario administrador inicial (se crea solo si no existe)
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambie-esta-clave-admin

# Puerto donde queda publicada la aplicación
WEB_PORT=8080

# SLA de notificación por criticidad: minutos entre la alerta del SIEM y el reporte al cliente
SLA_CRITICA=35
SLA_ALTA=45
SLA_MEDIA=120
SLA_BAJA=240

# Carpeta del equipo con los Excel/CSV a migrar (se monta en /datos dentro del contenedor)
DATOS_DIR=./datos

# ---------------- GLPI 10 (API REST) ----------------
# Dejar GLPI_URL vacío desactiva la integración.
# En GLPI: Configuración > General > API: habilitar la API REST, crear un cliente de API (App-Token)
# y, en el usuario de servicio, generar el "Token de API" (GLPI_USER_TOKEN).
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_VERIFICAR_SSL=true
# 1 = Incidente, 2 = Solicitud
GLPI_TIPO_TICKET=1
# Opcionales: ID de la categoría ITIL y del origen de la solicitud
GLPI_CATEGORIA_ID=
GLPI_ORIGEN_ID=
# Casilla "Crear ticket en GLPI" marcada por defecto en el formulario
GLPI_CREAR_POR_DEFECTO=true
# Al cerrar un caso, registrar la solución en GLPI
GLPI_RESOLVER_AL_CERRAR=true
# Minutos entre sincronizaciones del estado de los tickets (0 = solo manual)
GLPI_SYNC_MINUTOS=10

# ---------------- Correo de alerta al cliente ----------------
# Los destinatarios de cada cliente se administran en la aplicación (Clientes > Correos)
CORREO_CC=soc@wexler.com.co
CORREO_CCO=alertassoc@wexler.com.co
CORREO_DOMINIO_PROPIO=wexler.com.co
CORREO_PLAZO_HORAS=48
CORREO_TLP=TLP:RED
# Archivos: MB por correo, por archivo y por caso
CORREO_MAX_MB=15
ADJUNTO_MAX_MB=15
ADJUNTOS_CASO_MAX_MB=60
# Mapa de la presentación: se carga de Internet en el navegador. Para no usarlo: MAPA_BASE=no (quedan las ubicaciones)
# MAPA_BASE=no
